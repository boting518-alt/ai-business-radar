# Copy this file to a local environment file and fill in values as services are configured.
# Never commit credentials or secrets.

# Application
APP_ENV=development
APP_NAME=YouTube AI Business Radar API
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Supabase and database
# postgresql://... and postgresql+asyncpg://... are supported.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only legacy Supabase HS256 JWT verification settings.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# Queue
REDIS_URL=

# YouTube
YOUTUBE_API_KEY=
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3/
YOUTUBE_HTTP_TIMEOUT_SECONDS=10
YOUTUBE_MAX_RETRIES=3
YOUTUBE_DISCOVERY_MAX_QUOTA_UNITS_PER_RUN=500
YOUTUBE_COMMENT_MAX_QUOTA_UNITS_PER_RUN=500
YOUTUBE_STAGING_CLAIM_TIMEOUT_MINUTES=30
YOUTUBE_STAGING_RECOVERY_BATCH_SIZE=100
YOUTUBE_DISCOVERY_SCHEDULE_BATCH_SIZE=10
YOUTUBE_METADATA_BATCH_SIZE=50
YOUTUBE_COMMENT_BATCH_SIZE=20
YOUTUBE_DISCOVERY_SCHEDULE_MINUTES=360
YOUTUBE_METADATA_SCHEDULE_MINUTES=30
YOUTUBE_COMMENT_SCHEDULE_MINUTES=120
YOUTUBE_STALE_RECOVERY_SCHEDULE_MINUTES=15

# AI relevance provider (required only when running the relevance pipeline)
AI_PROVIDER=
AI_MODEL_RELEVANCE=
AI_MODEL_SIGNAL_EXTRACTION=
AI_MODEL_COMMENT_PAIN_MINING=
AI_MAX_RETRIES=2
OPENAI_API_KEY=
